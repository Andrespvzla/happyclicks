---
import Header from '../components/Header.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Capture unforgettable moments with our premier Photo Booth services in Atlanta, GA and surroundings. From weddings to corporate events, our cutting-edge technology ensures every smile is preserved in stunning clarity. Book now for an experience that adds an extra touch of magic to your special occasion!"
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/ico" href="/favicon_io/favicon-32x32.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <Header />
        <slot />
    </body>
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;1,500&family=Onest:wght@300;400;500;600;700&display=swap');

        :root {
            --bg: #faf8f4;
            --bg-2: #ffffff;
            --bg-3: #f1ede6;
            --ink: #17150f;
            --muted: #6b655a;
            --gold: #a8863c;
            --gold-bright: #c6a667;
            --gold-deep: #8a6e2e;
            --line: rgba(23, 21, 15, 0.12);
            --line-gold: rgba(168, 134, 60, 0.34);
            --maxw: 1200px;
            --header-h: 101px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: 'Onest', system-ui, -apple-system, 'Segoe UI', sans-serif;
            font-weight: 400;
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
            letter-spacing: 0.005em;
            display: block;
        }

        h1,
        h2,
        h3,
        .serif {
            font-family: 'Cormorant', Georgia, serif;
            font-weight: 500;
            line-height: 1.04;
            margin: 0;
            text-wrap: balance;
            letter-spacing: 0.005em;
        }

        p {
            margin: 0;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .wrap {
            width: 100%;
            max-width: var(--maxw);
            margin: 0 auto;
            padding: 0 32px;
        }
        @media (max-width: 640px) {
            .wrap {
                padding: 0 22px;
            }
        }

        .gold {
            color: var(--gold);
        }
        .it {
            font-style: italic;
        }
        .tnum {
            font-variant-numeric: tabular-nums;
        }

        .eyebrow {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.34em;
            text-transform: uppercase;
            color: var(--gold);
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
        }
        .eyebrow::before {
            content: '';
            width: 26px;
            height: 1px;
            background: var(--gold);
            opacity: 0.7;
            display: inline-block;
        }
        .eyebrow.c::after {
            content: '';
            width: 26px;
            height: 1px;
            background: var(--gold);
            opacity: 0.7;
            display: inline-block;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-family: 'Onest';
            font-weight: 500;
            font-size: 0.82rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            padding: 1rem 1.8rem;
            cursor: pointer;
            border: 1px solid var(--gold);
            background: transparent;
            color: var(--gold);
            transition:
                background 0.35s ease,
                color 0.35s ease,
                transform 0.3s ease;
        }
        .btn:hover {
            transform: translateY(-2px);
        }
        .btn.solid {
            background: var(--gold);
            color: #141110;
        }
        .btn.solid:hover {
            background: var(--gold-bright);
        }
        .btn.ghost {
            border-color: var(--line);
        }
        .btn.ghost:hover {
            border-color: var(--gold);
            color: var(--gold);
        }

        /* NAV */
        header.nav {
            position: sticky;
            top: 0;
            z-index: 60;
            background: color-mix(in srgb, var(--bg) 82%, transparent);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
        }
        .nav-in {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-block: 14px;
            gap: 1.2rem;
        }
        /* logo.png is a square canvas with lots of empty space above/below — clip it so the bar stays slim */
        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex: 0 0 auto;
            height: 72px;
            overflow: hidden;
        }
        .brand img {
            width: 120px;
            height: 120px;
            flex: 0 0 auto;
            display: block;
        }
        @media (max-width: 480px) {
            .brand {
                height: 60px;
            }
            .brand img {
                width: 104px;
                height: 104px;
            }
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-left: auto;
        }
        .nav-links a.lnk {
            font-size: 0.74rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
            transition: color 0.25s;
            position: relative;
        }
        .nav-links a.lnk:hover {
            color: var(--ink);
        }
        .nav-links a.lnk::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -6px;
            width: 0;
            height: 1px;
            background: var(--gold);
            transition: width 0.3s;
        }
        .nav-links a.lnk:hover::after {
            width: 100%;
        }
        @media (max-width: 1080px) {
            .nav-links {
                gap: 1.4rem;
            }
        }
        @media (max-width: 900px) {
            .nav-links a.lnk {
                display: none;
            }
        }

        /* Phone + email always visible so planners can grab them at a glance */
        .nav-contact {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
        }
        @media (max-width: 480px) {
            .nav-contact {
                flex-direction: row;
                gap: 1rem;
            }
        }
        .nav-cta {
            padding: 0.7rem 1.3rem;
        }
        @media (max-width: 480px) {
            .nav-cta {
                padding: 0.65rem 0.9rem;
                font-size: 0.72rem;
                letter-spacing: 0.1em;
            }
        }

        /* Always-visible phone badge (client wants the number visible at all times) */
        .phone-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gold-deep);
            font-family: 'Onest';
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            white-space: nowrap;
            transition: color 0.25s;
        }
        .phone-badge:hover {
            color: var(--gold);
        }
        .phone-badge svg {
            flex: 0 0 auto;
            width: 15px;
            height: 15px;
        }
        @media (max-width: 480px) {
            .phone-badge .phone-text {
                display: none;
            }
        }

        /* Marquee thin */
        .strip-bar {
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            overflow: hidden;
        }
        .strip-track {
            display: flex;
            gap: 0;
            white-space: nowrap;
            width: max-content;
            animation: slide 40s linear infinite;
        }
        .strip-track span {
            display: inline-flex;
            align-items: center;
        }
        .strip-track em {
            font-family: 'Cormorant';
            font-style: italic;
            font-size: 1.5rem;
            color: var(--ink);
            padding: 18px 34px;
        }
        .strip-track i {
            color: var(--gold);
            font-size: 0.5rem;
        }
        @keyframes slide {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-50%);
            }
        }

        section {
            padding: clamp(72px, 9vw, 128px) 0;
        }
        section[id] {
            scroll-margin-top: 56px;
        }
        .sec-head h2 {
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            margin-top: 1rem;
        }
        .sec-sub {
            color: var(--muted);
            font-weight: 300;
            font-size: 1.05rem;
            margin-top: 1.2rem;
        }
        .center {
            text-align: center;
            margin-inline: auto;
        }

        /* Stat row (shared by hero) */
        .stat-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0;
            margin-top: clamp(48px, 6vw, 80px);
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }
        .stat {
            flex: 1 1 25%;
            padding: 15px 8px;
            text-align: center;
        }
        .stat + .stat {
            border-left: 1px solid var(--line);
        }
        .stat b {
            font-family: 'Cormorant';
            font-size: 2.1rem;
            font-weight: 600;
            display: block;
            line-height: 1;
        }
        .stat span {
            font-size: 0.64rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }
        @media (max-width: 560px) {
            .stat {
                flex: 1 1 50%;
                border-left: none !important;
            }
            .stat:nth-child(odd) {
                border-right: 1px solid var(--line);
            }
            .stat:nth-child(n + 3) {
                border-top: 1px solid var(--line);
            }
        }

        /* HERO (video) */
        .hero-video {
            position: relative;
            min-height: calc(100svh - var(--header-h));
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            text-align: center;
        }
        .hero-video video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }
        .hero-video::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(10, 9, 6, 0.42) 0%, rgba(10, 9, 6, 0.68) 100%);
            z-index: -1;
        }
        .hero-video .wrap {
            padding: 40px 32px;
            max-width: 900px;
        }
        .hero-video .eyebrow {
            justify-content: center;
            color: var(--gold-bright);
        }
        .hero-video .eyebrow::before,
        .hero-video .eyebrow.c::after {
            background: var(--gold-bright);
        }
        .hero-video h1 {
            color: #fff;
            font-size: clamp(2.4rem, 6.4vw, 4.6rem);
            letter-spacing: -0.01em;
            margin: 1rem 0 0;
        }
        .hero-video h1 .it {
            color: var(--gold-bright);
        }
        .hero-video .lead {
            color: rgba(255, 255, 255, 0.82);
            font-size: 1.05rem;
            font-weight: 300;
            max-width: 46ch;
            margin: 1rem auto 0;
        }
        .hero-cta {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            margin-top: 1.4rem;
        }
        .hero-video .btn.ghost {
            border-color: rgba(255, 255, 255, 0.4);
            color: #fff;
        }
        .hero-video .btn.ghost:hover {
            border-color: var(--gold-bright);
            color: var(--gold-bright);
        }

        /* About */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 72px;
            align-items: center;
        }
        @media (max-width: 900px) {
            .about-grid {
                grid-template-columns: 1fr;
                gap: 44px;
            }
        }
        .about-copy p {
            color: var(--muted);
            font-size: 1.08rem;
            margin-top: 1.4rem;
            font-weight: 300;
        }
        .about-copy .sig {
            font-family: 'Cormorant';
            font-style: italic;
            font-size: 1.5rem;
            color: var(--gold);
            margin-top: 1.8rem;
        }
        .frame-img {
            position: relative;
            margin: 0;
            padding: 16px;
            border: 1px solid var(--line-gold);
        }
        .duo {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            align-items: start;
        }
        .duo .frame-img {
            padding: 10px;
        }
        .duo .frame-img:last-child {
            margin-top: 48px;
        }
        .duo .frame-img .pic {
            aspect-ratio: 4/5;
        }
        .duo .pic-booth {
            object-position: center 25%;
        }
        .duo .pic-printer {
            object-position: center 75%;
        }
        @media (max-width: 560px) {
            .duo {
                gap: 12px;
            }
            .duo .frame-img {
                padding: 6px;
            }
            .duo .frame-img:last-child {
                margin-top: 28px;
            }
            .duo .plabel {
                right: 8px;
                padding: 6px 10px;
                font-size: 0.58rem;
                letter-spacing: 0.18em;
            }
        }

        /* About Us (founders' story) */
        #about-us {
            background: var(--bg-2);
            border-top: 1px solid var(--line);
        }
        .story-grid {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 72px;
            align-items: start;
        }
        .story-media {
            position: sticky;
            top: 120px;
        }
        .story-media .frame-img .pic {
            aspect-ratio: 4/5;
        }
        @media (max-width: 900px) {
            .story-grid {
                grid-template-columns: 1fr;
                gap: 44px;
            }
            .story-media {
                position: static;
            }
            .story-media .frame-img .pic {
                aspect-ratio: 3/2;
            }
        }
        .story-copy .story-quote {
            font-family: 'Cormorant';
            font-style: italic;
            font-size: 1.6rem;
            line-height: 1.3;
            color: var(--ink);
            border-left: 2px solid var(--gold);
            padding-left: 1.2rem;
        }
        .frame-img .pic {
            aspect-ratio: 4/5;
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }
        .frame-img .plabel {
            position: absolute;
            bottom: -1px;
            right: 16px;
            background: var(--bg);
            padding: 8px 16px;
            font-size: 0.66rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--gold);
            border: 1px solid var(--line-gold);
        }

        /* Prices */
        #prices {
            background: var(--bg-2);
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }
        .price-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: var(--line);
            border: 1px solid var(--line);
            margin-top: 3.5rem;
        }
        @media (max-width: 900px) {
            .price-grid {
                grid-template-columns: 1fr;
            }
        }
        .plan {
            background: var(--bg);
            padding: 44px 36px;
            display: flex;
            flex-direction: column;
            position: relative;
            transition: background 0.4s;
        }
        .plan:hover {
            background: var(--bg-3);
        }
        .plan.feat {
            background: var(--bg-3);
        }
        .plan.feat::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gold-deep), var(--gold-bright), var(--gold-deep));
        }
        .tagpop {
            font-size: 0.62rem;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1rem;
        }
        .plan-name {
            font-family: 'Cormorant';
            font-size: 1.9rem;
            font-weight: 600;
        }
        .price-label {
            font-size: 0.68rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
            margin-top: 0.9rem;
        }
        .price {
            font-family: 'Cormorant';
            font-size: 3.4rem;
            font-weight: 600;
            margin: 0.3rem 0 0;
            line-height: 1;
            letter-spacing: -0.01em;
        }
        .price small {
            font-size: 1.1rem;
            color: var(--muted);
        }
        .price .unit {
            font-family: 'Onest';
            font-size: 0.7rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
            display: block;
            margin-top: 0.6rem;
        }
        .plan ul {
            list-style: none;
            padding: 2rem 0;
            margin: 1.6rem 0 0;
            border-top: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex: 1;
        }
        .li {
            display: flex;
            gap: 0.9rem;
            align-items: flex-start;
            color: var(--muted);
            font-size: 0.95rem;
            font-weight: 300;
        }
        .li svg {
            flex: 0 0 auto;
            width: 16px;
            height: 16px;
            margin-top: 4px;
            color: var(--gold);
        }
        .li b {
            color: var(--ink);
            font-weight: 500;
        }
        .plan .btn {
            margin-top: 2rem;
            justify-content: center;
            width: 100%;
        }

        .note {
            background: var(--bg-3);
            border: 1px solid var(--line-gold);
            padding: 18px 22px;
            font-size: 0.9rem;
            color: var(--muted);
            margin-top: 2.4rem;
            font-weight: 300;
            text-align: center;
        }
        .note b,
        .note a {
            color: var(--gold-deep);
            font-weight: 500;
        }
        .note a:hover {
            color: var(--gold);
        }

        /* Testimonials */
        .t-head {
            position: relative;
        }
        .qmark {
            font-family: 'Cormorant';
            font-size: 9rem;
            line-height: 0.6;
            color: var(--gold);
            opacity: 0.5;
            display: block;
        }
        .t-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            margin-top: 3rem;
            border-top: 1px solid var(--line);
        }
        @media (max-width: 820px) {
            .t-grid {
                grid-template-columns: 1fr;
            }
        }
        .quote {
            padding: 44px 36px;
            border-bottom: 1px solid var(--line);
        }
        .quote + .quote {
            border-left: 1px solid var(--line);
        }
        @media (max-width: 820px) {
            .quote + .quote {
                border-left: 0;
            }
        }
        .quote .stars {
            color: var(--gold);
            letter-spacing: 0.35em;
            font-size: 0.8rem;
        }
        .quote p {
            font-family: 'Cormorant';
            font-size: 1.18rem;
            line-height: 1.42;
            margin: 1.2rem 0 1.6rem;
            color: var(--ink);
            font-weight: 500;
        }
        .quote .who {
            font-size: 0.72rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .quote .who b {
            color: var(--gold);
            font-weight: 500;
        }

        /* Contact */
        #contact {
            border-top: 1px solid var(--line);
        }
        .contact-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--line);
            border: 1px solid var(--line);
            margin-top: 3rem;
        }
        .ccard {
            background: var(--bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.4rem;
            padding: 36px 16px;
            transition: background 0.3s;
            min-width: 0;
        }
        .ccard:hover {
            background: var(--bg-3);
        }
        .ccard .ic {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 1px solid var(--line-gold);
            color: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.6rem;
            transition: transform 0.3s, background 0.3s, color 0.3s;
        }
        .ccard:hover .ic {
            background: var(--gold);
            color: #141110;
            transform: translateY(-3px);
        }
        .ccard .txt {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            min-width: 0;
        }
        .ccard .lbl {
            font-family: 'Cormorant';
            font-size: 1.45rem;
            color: var(--ink);
            line-height: 1.1;
        }
        .ccard .val {
            font-size: 0.85rem;
            color: var(--muted);
            overflow-wrap: anywhere;
        }
        @media (max-width: 900px) {
            .contact-cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 560px) {
            .contact-cards {
                grid-template-columns: 1fr;
            }
            .ccard {
                flex-direction: row;
                text-align: left;
                gap: 1rem;
                padding: 18px 20px;
            }
            .ccard .ic {
                margin-bottom: 0;
                width: 44px;
                height: 44px;
                flex: 0 0 auto;
            }
        }

        /* Get a Quote */
        #quote {
            background: var(--bg-2);
            border-top: 1px solid var(--line);
        }
        .quote-wrap {
            max-width: 780px;
        }
        #quote form {
            margin-top: 3rem;
        }
        #quote form .btn {
            align-self: center;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 0;
        }
        .field {
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
            position: relative;
        }
        .field label {
            font-size: 0.66rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--gold);
            display: block;
            margin-bottom: 0.5rem;
        }
        .field input,
        .field textarea {
            width: 100%;
            background: transparent;
            border: 0;
            color: var(--ink);
            font: inherit;
            font-size: 1.05rem;
            padding: 0.3rem 0;
            outline: none;
            font-family: 'Onest';
        }
        .field input::placeholder,
        .field textarea::placeholder {
            color: var(--muted);
            opacity: 0.6;
        }

        /* Custom dropdown (replaces native <select>, whose popup can't be restyled) */
        .cselect {
            position: relative;
        }
        .cselect-trigger {
            width: 100%;
            background: transparent;
            border: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.6rem;
            font: inherit;
            font-size: 1.05rem;
            font-family: 'Onest';
            color: var(--muted);
            padding: 0.3rem 0;
            cursor: pointer;
            text-align: left;
        }
        .cselect-trigger.has-value {
            color: var(--ink);
        }
        .cselect-arrow {
            width: 13px;
            height: 13px;
            flex: 0 0 auto;
            color: var(--gold);
            transition: transform 0.25s ease;
        }
        .cselect-trigger[aria-expanded='true'] .cselect-arrow {
            transform: rotate(180deg);
        }
        .cselect-list {
            position: absolute;
            top: calc(100% + 12px);
            left: 0;
            right: 0;
            z-index: 40;
            list-style: none;
            margin: 0;
            padding: 6px;
            max-height: 260px;
            overflow-y: auto;
            background: var(--bg-2);
            border: 1px solid var(--line-gold);
            box-shadow: 0 24px 48px rgba(23, 21, 15, 0.16);
            opacity: 0;
            transform: translateY(-8px);
            pointer-events: none;
            transition:
                opacity 0.2s ease,
                transform 0.2s ease;
        }
        .cselect-list.open {
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }
        .cselect-list li {
            padding: 0.7rem 0.9rem;
            font-size: 0.95rem;
            color: var(--ink);
            cursor: pointer;
            transition:
                background 0.15s ease,
                color 0.15s ease;
        }
        .cselect-list li.active {
            background: var(--bg-3);
            color: var(--gold-deep);
        }
        .cselect-list li[aria-selected='true'] {
            color: var(--gold);
            font-weight: 500;
        }
        .cselect.invalid .cselect-trigger {
            color: #b3452e;
        }
        .field::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -1px;
            height: 1px;
            width: 0;
            background: var(--gold);
            transition: width 0.3s;
        }
        .field:focus-within::after {
            width: 100%;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 28px;
        }
        @media (max-width: 520px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        form .btn {
            margin-top: 2rem;
            align-self: flex-start;
        }

        footer {
            border-top: 1px solid var(--line-gold);
            padding: 44px 0;
        }
        .foot-in {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        .foot-in .brand-name {
            font-family: 'Cormorant';
            font-size: 1.4rem;
        }
        .foot-in .meta {
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            text-align: right;
        }
        .foot-in .meta a {
            color: var(--gold-deep);
        }
        .foot-in .meta a:hover {
            color: var(--gold);
        }

        .reveal {
            opacity: 0;
            transform: translateY(22px);
            transition:
                opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
                transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .reveal.in {
            opacity: 1;
            transform: none;
        }
        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
                scroll-behavior: auto !important;
            }
            .reveal {
                opacity: 1;
                transform: none;
            }
        }
    </style>
    <script>
        function initReveal() {
            if (matchMedia('(prefers-reduced-motion:reduce)').matches) {
                document.querySelectorAll('.reveal').forEach((e) => e.classList.add('in'));
                return;
            }
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('in');
                            io.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.14 },
            );
            document.querySelectorAll('.reveal').forEach((e) => io.observe(e));
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReveal);
        } else {
            initReveal();
        }
        document.addEventListener('astro:page-load', initReveal);

        // Smooth-scroll to in-page sections without leaving a #hash in the address bar.
        function initHashlessNav() {
            document.querySelectorAll('a[href^="#"]').forEach((link) => {
                link.addEventListener('click', (e) => {
                    const hash = link.getAttribute('href');
                    if (!hash || hash.length < 2) return;
                    const target = document.getElementById(hash.slice(1));
                    if (!target) return;
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    history.replaceState(null, '', window.location.pathname + window.location.search);
                });
            });

            if (window.location.hash) {
                window.setTimeout(() => {
                    history.replaceState(null, '', window.location.pathname + window.location.search);
                }, 400);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initHashlessNav);
        } else {
            initHashlessNav();
        }
        document.addEventListener('astro:page-load', initHashlessNav);
    </script>
</html>
