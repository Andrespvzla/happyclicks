        <form action="https://formspree.io/f/xayranzj" method="POST" class="reveal">
            <div class="form-row">
                <div class="field">
                    <label for="email">Your email</label>
                    <input id="email" type="email" name="email" placeholder="you@email.com" required />
                </div>
                <div class="field">
                    <label for="phone">Phone number</label>
                    <input id="phone" type="tel" name="phone" placeholder="(470) 716-5087" required />
                </div>
            </div>
            <div class="field">
                <label for="type-event">Type of event</label>
                <select id="type-event" name="type-event" required>
                    <option value="" disabled selected>Select your event type</option>
                    <option value="weddings">Weddings</option>
                    <option value="birthdays">Birthdays</option>
                    <option value="corporate">Corporate</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="field">
                <label for="message">Add details</label>
                <textarea
                    id="message"
                    name="message"
                    rows="4"
                    placeholder="Name, number of guests, location and date"></textarea>
            </div>
            <button class="btn solid" type="submit">Get a Quote</button>
        </form>
