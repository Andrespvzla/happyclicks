const categories = ["all", "weddings", "birthdays", "corporate"];
---

<section id="gallery">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">The good times</span>
      <h2>A glimpse of the fun</h2>
    </div>

    <div id="gallery-tabs" role="tablist" class="gtabs">
      {
        categories.map((cat) => (
          <button
            type="button"
            role="tab"
            data-category={cat}
            aria-selected={cat === "all" ? "true" : "false"}
            class="gtab"
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div id="gallery-grid" class="ggrid pswp-gallery">
      {
        images.map((img, i) => (
          <a
            href={img.src}
            target="_blank"
            data-pswp-width={img.w}
            data-pswp-height={img.h}
            data-category={img.category}
            class={`gtile ${i > 7 ? "hidden all-extra" : ""}`}
          >
            <img
              src={img.src}
              alt="Happy Clicks Customers"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>

    <div class="gmore">
      <button id="load-more" class="btn ghost">
        <svg
          id="spinner"
          class="animate-spin hidden"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="m12 2a10 10 0 0 1 10 10h-4a6 6 0 0 0-6-6z"></path>
        </svg>
        <span id="load-more-text">Load more</span>
      </button>
    </div>
  </div>
</section>

<script>
  // Funcion para inicializar la galeria
  function initializeGallery() {
    const TABS = document.querySelectorAll(
      "#gallery-tabs [role=tab]"
    ) as NodeListOf<HTMLButtonElement>;
    const GALLERY = document.getElementById("gallery-grid") as HTMLElement;
    const LOAD_BTN = document.getElementById("load-more") as HTMLButtonElement;

    if (!TABS.length || !GALLERY || !LOAD_BTN) {
      console.error("Gallery elements not found");
      return;
    }

    let currentCategory = "all";
    let visibleCount = 8;
    let lightbox: any = null;

    const setLoadingState = (loading: boolean) => {
      const spinner = document.getElementById("spinner") as HTMLElement;
      const loadMoreText = document.getElementById(
        "load-more-text"
      ) as HTMLElement;

      if (loading) {
        LOAD_BTN.disabled = true;
        spinner.classList.remove("hidden");
        loadMoreText.textContent = "Loading...";
      } else {
        LOAD_BTN.disabled = false;
        spinner.classList.add("hidden");
        loadMoreText.textContent = "Load more";
      }
    };

    const animateElement = (element: HTMLElement, show: boolean) => {
      if (show) {
        element.style.opacity = "0";
        element.style.transform = "translateY(20px)";
        element.classList.remove("hidden");
        element.offsetHeight;

        element.style.transition =
          "opacity 200ms ease-out, transform 200ms ease-out";
        element.style.opacity = "1";
        element.style.transform = "translateY(0)";
      } else {
        element.style.transition =
          "opacity 200ms ease-out, transform 200ms ease-out";
        element.style.opacity = "0";
        element.style.transform = "translateY(-20px)";

        setTimeout(() => {
          element.classList.add("hidden");
        }, 400);
      }
    };

    const initLightbox = async () => {
      try {
        if (lightbox && typeof lightbox.destroy === "function") {
          lightbox.destroy();
        }

        const { default: PhotoSwipeLightBox } = await import(
          "photoswipe/lightbox"
        );

        lightbox = new PhotoSwipeLightBox({
          gallery: "#gallery-grid",
          children: "a:not(.hidden)",
          pswpModule: () => import("photoswipe"),
        });

        lightbox.init();
      } catch (error) {
        console.warn("PhotoSwipe not available:", error);
      }
    };

    // Función para sincronizar visibilidad con animaciones
    const syncVisibility = () => {
      const links = [...GALLERY.querySelectorAll("a")] as HTMLAnchorElement[];

      // Primero, ocultar elementos que no deben mostrarse
      links.forEach((a, idx) => {
        const match =
          currentCategory === "all" || a.dataset.category === currentCategory;
        const show = match && (currentCategory !== "all" || idx < visibleCount);

        if (!show && !a.classList.contains("hidden")) {
          animateElement(a, false);
        }
      });

      setTimeout(() => {
        links.forEach((a, idx) => {
          const match =
            currentCategory === "all" || a.dataset.category === currentCategory;
          const show =
            match && (currentCategory !== "all" || idx < visibleCount);

          if (show && a.classList.contains("hidden")) {
            setTimeout(() => {
              animateElement(a, true);
            }, idx * 50);
          }
        });
        setTimeout(() => {
          initLightbox();
        }, 500);
      }, 100);

      const shouldShowLoadMore =
        currentCategory === "all" && visibleCount < links.length;
      if (shouldShowLoadMore) {
        LOAD_BTN.style.display = "flex";
        LOAD_BTN.style.opacity = "1";
      } else {
        LOAD_BTN.style.opacity = "0";
        setTimeout(() => {
          LOAD_BTN.style.display = "none";
        }, 300);
      }
    };

    TABS.forEach((tab: HTMLButtonElement) => {
      tab.addEventListener("click", (e: Event) => {
        e.preventDefault();

        TABS.forEach((t: HTMLButtonElement) =>
          t.setAttribute("aria-selected", "false")
        );
        tab.setAttribute("aria-selected", "true");

        currentCategory = tab.dataset.category || "all";
        visibleCount = 8;

        syncVisibility();
      });
    });

    LOAD_BTN.addEventListener("click", (e: Event) => {
      e.preventDefault();

      setLoadingState(true);

      visibleCount += 8;
      syncVisibility();

      setTimeout(() => {
        setLoadingState(false);
      }, 1000);
    });

    // Inicializar
    syncVisibility();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeGallery);
  } else {
    initializeGallery();
  }

  document.addEventListener("astro:page-load", initializeGallery);
</script>

<style>
  .gtabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 3rem;
  }

  .gtab {
    font-family: "Onest";
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .gtab:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .gtab[aria-selected="true"] {
    background: var(--gold);
    border-color: var(--gold);
    color: #141110;
  }

  .ggrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 2.6rem;
  }

  @media (max-width: 820px) {
    .ggrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gtile {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    transition:
      opacity 300ms ease-out,
      transform 300ms ease-out;
  }

  .gtile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1/1;
    transition: transform 0.5s ease;
  }

  .gtile:hover img {
    transform: scale(1.06);
  }

  .gtile:hover {
    border-color: var(--gold);
  }

  .hidden {
    display: none !important;
  }

  .gmore {
    display: flex;
    justify-content: center;
    margin-top: 2.8rem;
  }

  #load-more {
    transition:
      opacity 300ms ease-in-out,
      transform 200ms ease-in-out;
  }

  #load-more:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #spinner {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
