---
import Layout from '../layouts/Layout.astro';
import Prices from '../components/Prices.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import AboutUs from '../components/AboutUs.astro';
import Quote from '../components/Quote.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="HappyClicks | Photo Booth">
    <main id="top">
        <section class="hero-video">
            <video playsinline autoplay loop muted>
                <source src="/video.mov" type="video/mp4" />
                Your browser does not support the video tag.
            </video>
            <div class="wrap">
                <span class="eyebrow">Atlanta, GA &middot; Luxury Photo Booth</span>
                <h1>Where every click<br />becomes a <span class="it">memory</span>.</h1>
                <p class="lead">
                    A refined photo-booth experience for weddings, celebrations and corporate events — DSLR quality,
                    elegant prints, and a night your guests won't forget.
                </p>
                <div class="hero-cta">
                    <a class="btn solid" href="#quote">Get a Quote</a>
                    <a class="btn ghost" href="#prices">View packages</a>
                </div>
            </div>
        </section>

        <div class="strip-bar" aria-hidden="true">
            <div class="strip-track">
                <span
                    ><em>Weddings</em><i>&#9670;</i><em>Birthdays</em><i>&#9670;</i><em>Baby Showers</em><i>&#9670;</i><em>Corporate</em><i
                        >&#9670;</i
                    ><em>Engagements</em><i>&#9670;</i><em>Quinceañeras</em><i>&#9670;</i><em>Graduations</em><i
                        >&#9670;</i
                    ></span
                >
                <span
                    ><em>Weddings</em><i>&#9670;</i><em>Birthdays</em><i>&#9670;</i><em>Baby Showers</em><i>&#9670;</i><em>Corporate</em><i
                        >&#9670;</i
                    ><em>Engagements</em><i>&#9670;</i><em>Quinceañeras</em><i>&#9670;</i><em>Graduations</em><i
                        >&#9670;</i
                    ></span
                >
            </div>
        </div>

        <WhatWeDo />
        <Prices />
        <Gallery />
        <Testimonials />
        <AboutUs />
        <Contact />
        <Quote />
        <Footer />
    </main>
</Layout>
